""""""""""""""""""""
" Basic Config
""""""""""""""""""""

" Show line numbers
set number

" Enable syntax highlighting
syntax on

" Allow mouse support
set mouse=a

" Search highlighting
set hlsearch

" Incramental Search
set incsearch

" Case sensitive off and smart case on - case insensitive unless uppercase
" used
set ignorecase
set smartcase

" Matching bracket
set showmatch

"""""""""""""""""""""
" Indentation & Tabs
""""""""""""""""""""

set tabstop=4
set shiftwidth=4
set expandtab
set softtabstop=4

"""""""""""""""""""""
" Interface & Usage
""""""""""""""""""""

" Show status line
set laststatus=2

" Make backspaces normal
set backspace=indent,eol,start

"""""""""""""""""""""
" Filetype Plugins
""""""""""""""""""""

filetype plugin indent on

"""""""""""""""""""""
" Visuals
""""""""""""""""""""

" Prevent wrapping of long lines
set nowrap

" Cursor position
set ruler
set relativenumber
set cursorline
